{
  "name": "chatluna-plugin-music-voice",
  "version": "0.0.1",
  "description": "为 ChatLuna v2 提供网易云与 QQ 音乐搜索、音频链接解析和音乐卡片发送工具",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sor85/chatluna-plugin-music-voice.git"
  },
  "keywords": ["chatluna-plugin", "music", "voice", "netease", "qqmusic"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json",
    "./client": { "types": "./client/index.ts", "default": "./client/index.ts" }
  },
  "files": ["lib", "dist", "client", "README.md", "LICENSE"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "sync": "node scripts/sync-to-v2.mjs --once",
    "sync:watch": "node scripts/sync-to-v2.mjs",
    "build": "yakumo build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "peerDependencies": {
    "@chatluna/schema": ">=2.0.0-alpha.0",
    "@chatluna/utils": ">=2.0.0-alpha.0",
    "@satorijs/core": "~4.6.1",
    "cordis": "^4.0.0-rc.12"
  },
  "devDependencies": {
    "@chatluna/chat": "workspace:*",
    "@chatluna/permission": "workspace:*",
    "@chatluna/schema": "workspace:*",
    "@chatluna/tool": "workspace:*",
    "@chatluna/ui-client": "workspace:*",
    "@chatluna/ui-kit": "workspace:*",
    "@chatluna/ui-schema-form": "workspace:*",
    "@chatluna/ui-server": "workspace:*",
    "@chatluna/utils": "workspace:*",
    "@cordisjs/plugin-http": "^1.5.2",
    "@cordisjs/plugin-server": "^1.7.0",
    "@cordisjs/unyaml": "^3.0.0",
    "@satorijs/core": "~4.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cordis": "4.0.0-rc.12",
    "jsdom": "^31.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  },
  "cordis": {
    "description": {
      "zh": "网易云与 QQ 音乐搜索、音频链接解析与音乐卡片发送",
      "en": "NetEase and QQ Music search, audio links for the model and music cards"
    },
    "service": { "required": ["http", "tools", "chat"], "optional": ["chatluna_webui"] }
  }
}
